{
  "name": "@calimero-network/mero-js",
  "version": "27.0.1",
  "description": "JavaScript client for Calimero 1.0: attested TEE nodes, a sealed channel, passkeys and API keys",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@phala/dcap-qvl": "0.5.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/node": "^18.19.34",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "rimraf": "^3.0.0",
    "semantic-release": "^24.2.9",
    "typescript": "^4.9.5",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=neutral --external:@phala/dcap-qvl --target=es2020 --format=esm --outfile=dist/index.mjs --sourcemap && esbuild src/index.ts --bundle --platform=neutral --external:@phala/dcap-qvl --target=es2020 --format=cjs --outfile=dist/index.cjs --sourcemap && esbuild src/index.ts --bundle --platform=browser --external:@phala/dcap-qvl --target=es2020 --format=esm --outfile=dist/index.browser.mjs --sourcemap --minify",
    "prepare": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:consumer": "tsc --noEmit -p tsconfig.consumer.json",
    "tsc": "tsc -b",
    "clean": "pnpm rimraf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test:unit && pnpm lint && pnpm typecheck && pnpm typecheck:consumer",
    "test:cloud-v2": "vitest run --config vitest.cloud-v2.config.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "calimero",
    "mero",
    "javascript",
    "tee",
    "confidential-computing",
    "passkeys",
    "sdk"
  ],
  "license": "MIT",
  "author": "Calimero Ltd",
  "repository": {
    "type": "git",
    "url": "https://github.com/calimero-network/mero-js",
    "directory": "mero-js"
  },
  "homepage": "https://github.com/calimero-network/mero-js/blob/master/README.md",
  "bugs": {
    "url": "https://github.com/calimero-network/mero-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748"
}
